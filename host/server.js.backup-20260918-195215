// ARQUIVOS
// ===============================

app.get("/files", (req, res) => {

  try {

    const relative =
      req.query.path || "";

    const directory =
      safePath(relative);

    const entries =
      fs.readdirSync(
        directory,
        { withFileTypes: true }
      );

    const files =
      entries.map(entry => ({

        name: entry.name,

        type:
          entry.isDirectory()
            ? "folder"
            : "file"

      }));

    res.json({
      path: relative,
      files
    });

  } catch (error) {

    res.status(400).json({
      error: error.message
    });

  }

});

