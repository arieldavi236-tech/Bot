// ===============================
// PM2
// ===============================

function pm2(args) {
  return new Promise((resolve, reject) => {
    execFile("pm2", args, (error, stdout, stderr) => {
      if (error) {
        reject(new Error(stderr || error.message));
        return;
      }

      resolve(stdout || stderr || "");
    });
  });
}

