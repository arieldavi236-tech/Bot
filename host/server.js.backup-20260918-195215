app.get("/status", async (req, res) => {

  try {

    const result = await pm2(["jlist"]);

    const processes = JSON.parse(result);

    const bot = processes.find(
      (process) => process.name === "ariel-bot"
    );

    const watchdog = processes.find(
      (process) => process.name === "shizuka-watchdog"
    );

    if (!bot) {

      return res.json({
        online: false,
        name: "ariel-bot",
        cpu: "0%",
        memory: "0 MB",
        systemMemory: "0%",
        uptime: "00:00:00",
        watchdog: Boolean(
          watchdog?.pm2_env?.status === "online"
        ),
        logs: "Processo ariel-bot não encontrado."
      });

    }

    let logs = "";

    try {

      logs = await pm2([
        "logs",
        "ariel-bot",
        "--lines",
        "25",
        "--nostream"
      ]);

    } catch (error) {

      logs = error.message;

    }

    const totalMemory = process.memoryUsage();

    const systemMemory = (
      (1 -
        (require("os").freemem() /
          require("os").totalmem())) *
      100
    ).toFixed(1);

    res.json({

      online:
        bot.pm2_env?.status === "online",

      name:
        bot.name,

      cpu:
        `${bot.monit?.cpu ?? 0}%`,

      memory:
        formatBytes(
          bot.monit?.memory ?? 0
        ),

      systemMemory:
        `${systemMemory}%`,

      uptime:
        bot.pm2_env?.pm_uptime
          ? formatUptime(
              Date.now() -
              bot.pm2_env.pm_uptime
            )
          : "00:00:00",

      watchdog:
        watchdog?.pm2_env?.status === "online",

      logs:
        logs || "Nenhum log disponível.",

      hostMemory:
        formatBytes(totalMemory.rss)

    });

  } catch (error) {

    res.status(500).json({
      online: false,
      error: error.message
    });

  }

});

