  path.resolve(__dirname, "..");

// =====================================================
// PM2
// =====================================================

function pm2(args) {
  return new Promise((resolve, reject) => {
    execFile("pm2", args, (error, stdout, stderr) => {
      if (error) {
        reject(
          new Error(
            String(stderr || error.message).trim()
          )
        );

        return;
      }

      resolve(stdout || stderr || "");
    });
  });
}

// =====================================================
