// ARQUIVOS
// =====================================================

app.get("/files", (req, res) => {

  try {

    const relative =
      req.query.path || "";

    const directory =
      safePath(relative);

    const entries =
      fs.readdirSync(
        directory,
        {
          withFileTypes: true
        }
      );

    const files =
      entries
        .sort((a, b) => {

          if (
            a.isDirectory() &&
            !b.isDirectory()
          ) {
            return -1;
          }

          if (
            !a.isDirectory() &&
            b.isDirectory()
          ) {
            return 1;
          }

          return a.name.localeCompare(
            b.name
          );

        })
        .map(entry => ({

          name:
            entry.name,

          type:
            entry.isDirectory()
              ? "folder"
              : "file"

        }));

    res.json({

      path:
        relative,

      files

    });

  } catch (error) {

    res.status(400).json({

      error:
        error.message

    });

  }

});

