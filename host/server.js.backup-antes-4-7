    document.getElementById("actionMessage");

  box.innerText = message;
  box.style.display = "block";

  setTimeout(() => {
    box.style.display = "none";
  }, 3500);

}

async function loadStatus() {

  try {

    const response =
      await fetch("/status", {
        cache: "no-store"
      });

    if (!response.ok) {
      throw new Error("Erro no status");
    }

    const data =
      await response.json();

    const status =
      document.getElementById("status");

    const watchdog =
      document.getElementById("watchdog");

    if (data.online) {

      status.innerText = "🟢 ONLINE";
      status.className = "status online";

    } else {

      status.innerText = "🔴 OFFLINE";
      status.className = "status offline";

    }

    document.getElementById("process").innerText =
      data.name || "ariel-bot";

    document.getElementById("cpu").innerText =
      data.cpu || "0%";

    document.getElementById("memory").innerText =
      data.memory || "0 MB";

    document.getElementById("systemMemory").innerText =
      data.systemMemory || "0%";

    document.getElementById("uptime").innerText =
      data.uptime || "00:00:00";

    const cpuValue =
      parseFloat(data.cpu) || 0;

    const ramValue =
      parseFloat(data.systemMemory) || 0;

    document.getElementById("cpuBar").style.width =
      Math.min(cpuValue, 100) + "%";

    document.getElementById("ramBar").style.width =
      Math.min(ramValue, 100) + "%";

    if (data.watchdog) {

      watchdog.innerText =
        "🛡️ WATCHDOG: ONLINE";

      watchdog.className =
        "status online";

      document.getElementById(
        "watchdogInfo"
      ).innerText =
        "Proteção automática ativa.";

    } else {

      watchdog.innerText =
        "🛡️ WATCHDOG: OFFLINE";

      watchdog.className =
        "status offline";

      document.getElementById(
        "watchdogInfo"
      ).innerText =
        "O watchdog não está ativo.";

    }

    document.getElementById("logs").innerText =
      data.logs ||
      "Nenhum log disponível.";

  } catch (error) {

    const status =
      document.getElementById("status");

    status.innerText =
      "⚠️ ERRO DE CONEXÃO";

    status.className =
      "status offline";

  }

}

async function action(type) {

  setButtonState(true);

  const names = {
    start: "Iniciando bot...",
    restart: "Reiniciando bot...",
    stop: "Parando bot..."
  };

  showActionMessage(
    names[type] || "Executando..."
  );

  try {

    const response =
      await fetch(
        "/action/" + type,
        {
          method: "POST"
        }
      );

    const data =
      await response.json();

    if (data.success) {

      showActionMessage(
        "✓ " + data.message
      );

    } else {

      showActionMessage(
        "⚠️ " + (
          data.message ||
          "Não foi possível executar."
        )
      );

    }

    setTimeout(
      loadStatus,
      1200
    );

  } catch {

    showActionMessage(
      "⚠️ Erro ao executar ação."
    );

  } finally {

    setTimeout(
      () => setButtonState(false),
      1200
    );

  }

}

async function loadFiles() {

  try {

    const response =
      await fetch(
        "/files",
        {
          cache: "no-store"
        }
      );

    const data =
      await response.json();

    const container =
      document.getElementById("files");

    if (
      !data.files ||
      data.files.length === 0
    ) {

      container.innerText =
        "Nenhum arquivo encontrado.";

      return;

    }

    container.innerHTML =
      data.files.map(file => {

        const icon =
          file.type === "folder"
            ? "📁"
            : "📄";

        const className =
          file.type === "folder"
            ? "folder"
            : "file-item";

        return \`
          <div class="file \${className}">
            \${icon} \${file.name}
          </div>
        \`;

      }).join("");

  } catch {

    document.getElementById(
      "files"
    ).innerText =
      "Erro ao carregar arquivos.";

  }

}

loadStatus();
loadFiles();

setInterval(
  loadStatus,
  5000
);

</script>

