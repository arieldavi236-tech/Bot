app.get("/status", async (req, res) => {

  try {

    const result =
      await pm2(["jlist"]);

    const processes =
      JSON.parse(result);

    const bot =
      processes.find(
        process =>
          process.name === BOT_NAME
      );

    const watchdog =
      processes.find(
        process =>
          process.name === WATCHDOG_NAME
      );

    const watchdogOnline =
      watchdog?.pm2_env?.status === "online";

    if (!bot) {

      return res.json({

        online: false,

        name: BOT_NAME,

        cpu: "0%",

        memory: "0 MB",

        systemMemory:
          `${systemMemoryPercent()}%`,

        uptime: "00:00:00",

        watchdog:
          watchdogOnline,

        logs:
          "Processo ariel-bot não encontrado."

      });

    }

    let logs = "";

    try {

      logs =
        await pm2([
          "logs",
          BOT_NAME,
          "--lines",
          "25",
          "--nostream",
          "--raw"
        ]);

      logs =
        cleanLogs(logs);

    } catch (error) {

      logs =
        cleanLogs(error.message);

    }

    res.json({

      online:
        bot.pm2_env?.status === "online",

      name:
        bot.name,

      cpu:
        `${bot.monit?.cpu ?? 0}%`,

      memory:
        formatBytes(
          bot.monit?.memory ?? 0
        ),

      systemMemory:
        `${systemMemoryPercent()}%`,

      uptime:
        bot.pm2_env?.pm_uptime
          ? formatUptime(
              Date.now() -
              bot.pm2_env.pm_uptime
            )
          : "00:00:00",

      watchdog:
        watchdogOnline,

      logs:
        logs ||
        "Nenhum log disponível.",

      hostMemory:
        formatBytes(
          process.memoryUsage().rss
        )

    });

  } catch (error) {

    res.status(500).json({

      online: false,

      error: error.message

    });

  }

});

