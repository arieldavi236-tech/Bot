import fs from "node:fs/promises";
import path from "node:path";

const SETTINGS_FILE = path.resolve("assets/admin-settings.json");

async function loadSettings() {
  try {
    return JSON.parse(await fs.readFile(SETTINGS_FILE, "utf8"));
  } catch {
    return {};
  }
}

async function saveSettings(data) {
  await fs.mkdir(path.dirname(SETTINGS_FILE), { recursive: true });
  await fs.writeFile(SETTINGS_FILE, JSON.stringify(data, null, 2));
}

function getParticipant(webMessage) {
  return (
    webMessage?.key?.participant?.replace(/:[0-9]+(?=@s\.whatsapp\.net)/, "") ||
    webMessage?.key?.participant
  );
}

function isAdmin(groupMetadata, jid) {
  const participant = groupMetadata?.participants?.find(
    (p) => p.id === jid
  );

  return Boolean(participant?.admin);
}

function getText(webMessage) {
  const message = webMessage?.message;
  if (!message) return "";

  return (
    message.conversation ||
    message.extendedTextMessage?.text ||
    message.imageMessage?.caption ||
    message.videoMessage?.caption ||
    ""
  );
}

export async function customMiddleware({
  socket,
  webMessage,
  type,
  commonFunctions,
  action,
  data,
}) {
  if (type === "participant") {
    if (action !== "add") return;

    const remoteJid = webMessage?.key?.remoteJid;
    if (!remoteJid) return;

    const settings = await loadSettings();
    const groupSettings = settings[remoteJid];

    if (!groupSettings?.welcome) return;

    const member = data?.replace(/:[0-9]+(?=@s\.whatsapp\.net)/, "");

    const text = groupSettings.welcome
      .replace(/@user/gi, `@${member?.split("@")[0] || ""}`);

    await socket.sendMessage(remoteJid, {
      text,
      mentions: member ? [member] : [],
    });

    return;
  }

  if (type !== "message") return;

  const remoteJid = webMessage?.key?.remoteJid;
  if (!remoteJid?.endsWith("@g.us")) return;

  const sender = getParticipant(webMessage);
  const text = getText(webMessage);

  if (!sender) return;

  const settings = await loadSettings();
  const groupSettings = settings[remoteJid] || {};

  let metadata;

  try {
    metadata = await socket.groupMetadata(remoteJid);
  } catch {
    return;
  }

  const senderIsAdmin = isAdmin(metadata, sender);

  // Anti-link
  if (groupSettings.antilink && text && !senderIsAdmin) {
    const linkRegex =
      /(https?:\/\/|www\.|chat\.whatsapp\.com\/|wa\.me\/|t\.me\/|discord\.gg\/)/i;

    if (linkRegex.test(text)) {
      try {
        await socket.sendMessage(remoteJid, {
          delete: {
            remoteJid,
            fromMe: false,
            id: webMessage.key.id,
            participant: webMessage.key.participant,
          },
        });

        await socket.sendMessage(remoteJid, {
          text: "🔗 Link removido. O anti-link está ativado neste grupo.",
        });
      } catch (error) {
        console.error("Erro ao remover link:", error.message);
      }

      return;
    }
  }

  // Slowmode
  const slowmode = Number(groupSettings.slowmode || 0);

  if (slowmode > 0 && !senderIsAdmin) {
    const now = Date.now();

    if (!globalThis.arielSlowmode) {
      globalThis.arielSlowmode = new Map();
    }

    const key = `${remoteJid}:${sender}`;
    const lastMessage = globalThis.arielSlowmode.get(key) || 0;

    if (now - lastMessage < slowmode * 1000) {
      try {
        await socket.sendMessage(remoteJid, {
          delete: {
            remoteJid,
            fromMe: false,
            id: webMessage.key.id,
            participant: webMessage.key.participant,
          },
        });
      } catch (error) {
        console.error("Erro ao remover mensagem do slowmode:", error.message);
      }

      return;
    }

    globalThis.arielSlowmode.set(key, now);
  }
}
